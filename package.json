{
  "name": "breathline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Breathline — community rescue and inspection planner (Life Underground hackathon prototype). Simulation — illustrative conditions and assumptions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "evidence": "tsx scripts/evidence.ts",
    "replay": "tsx scripts/replay.ts",
    "batch": "tsx scripts/batch.ts",
    "offline-check": "tsx scripts/offline-check.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/metropolis": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.9"
  }
}
